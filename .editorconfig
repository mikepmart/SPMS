# Project: SPMS | Project Author: Michael Mart | Prepared by Codex
# Purpose: Share readable indentation and whitespace defaults across editors.
# Requirements: AR-004, AR-005.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

